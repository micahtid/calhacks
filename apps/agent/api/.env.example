# Copy to .env (gitignored). On Railway, set these as service variables instead.
BITDEER_API_KEY=
BITDEER_MODEL=zai-org/GLM-5.3-Flash
APIFY_ACTOR_URL=https://lauded-crevasse--store-crawler.apify.actor
APIFY_TOKEN=
CORS_ORIGINS=http://localhost:3000
# Hunter's wallet key (Base Sepolia, needs test USDC from https://faucet.circle.com, no ETH). Without it, a run stops
# at "Approve the Exact Amount" and nothing is paid. Its address should match apps/agent/web/lib/wallet.ts.
BUYER_PRIVATE_KEY=
# SHIP_TO_NAME=Hunter Demo
# SHIP_TO_ADDRESS=1 Market St, San Francisco, CA
# STORE_URLS=https://amazon.hntr.store,https://ebay.hntr.store,https://depop.hntr.store,https://amazon-outlet.hntr.store
# Coinbase Developer Platform (portal.cdp.coinbase.com): API key, and the Wallet Secret from Non-custodial Wallet.
# Used only by Add Funds (the test USDC faucet).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
