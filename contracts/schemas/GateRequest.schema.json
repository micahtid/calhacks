{
  "$defs": {
    "CrsResult": {
      "additionalProperties": false,
      "properties": {
        "seller_id": {
          "title": "Seller Id",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        },
        "verified_at": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When verification was granted",
          "title": "Verified At"
        },
        "source": {
          "default": "crs",
          "description": "'crs' for the real API, 'stub' for the stand-in collection",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "seller_id",
        "verified"
      ],
      "title": "CrsResult",
      "type": "object"
    },
    "KnownSeller": {
      "additionalProperties": false,
      "properties": {
        "seller_id": {
          "title": "Seller Id",
          "type": "string"
        },
        "pay_to": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Pay To",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        }
      },
      "required": [
        "seller_id",
        "pay_to",
        "domain"
      ],
      "title": "KnownSeller",
      "type": "object"
    },
    "Mandate": {
      "additionalProperties": false,
      "description": "The user's rules, set once.",
      "properties": {
        "product_key": {
          "description": "What the user wants; stops injections that switch the product",
          "title": "Product Key",
          "type": "string"
        },
        "max_price": {
          "exclusiveMinimum": 0,
          "title": "Max Price",
          "type": "number"
        },
        "spend_remaining": {
          "minimum": 0,
          "title": "Spend Remaining",
          "type": "number"
        }
      },
      "required": [
        "product_key",
        "max_price",
        "spend_remaining"
      ],
      "title": "Mandate",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "description": "From the Scout.",
      "properties": {
        "listing_id": {
          "title": "Listing Id",
          "type": "string"
        },
        "scout_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Logged only; never used in decisions",
          "title": "Scout Notes"
        }
      },
      "required": [
        "listing_id"
      ],
      "title": "Proposal",
      "type": "object"
    },
    "References": {
      "additionalProperties": false,
      "description": "Looked up by the Gate. Never supplied by the store.",
      "properties": {
        "known_sellers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KnownSeller"
          },
          "title": "Known Sellers",
          "type": "array"
        },
        "crs_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrsResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "market_median": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Median"
        },
        "pay_to_first_seen": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pay To First Seen"
        }
      },
      "title": "References",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mandate": {
      "$ref": "#/$defs/Mandate"
    },
    "proposal": {
      "$ref": "#/$defs/Proposal"
    },
    "references": {
      "$ref": "#/$defs/References"
    }
  },
  "required": [
    "mandate",
    "proposal",
    "references"
  ],
  "title": "GateRequest",
  "type": "object"
}
