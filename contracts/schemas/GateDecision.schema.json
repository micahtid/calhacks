{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "enum": [
            "L1_PAYTO_MISMATCH",
            "L1_SELLER_UNTRUSTED",
            "L1_UNKNOWN_SELLER_CAP",
            "L1_AMOUNT_MISMATCH",
            "L1_OVER_MAX",
            "L1_OVER_BUDGET",
            "L1_NETWORK",
            "L1_ASSET",
            "L1_ITEM_MISMATCH",
            "L1_PRODUCT_MISMATCH",
            "L1_TIMEOUT"
          ],
          "title": "Rule",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "rule",
        "passed"
      ],
      "title": "Check",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "contribution": {
          "title": "Contribution",
          "type": "number"
        }
      },
      "required": [
        "feature",
        "value",
        "contribution"
      ],
      "title": "Reason",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "description": "The only thing the wallet obeys",
      "enum": [
        "buy",
        "skip"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decided_by": {
      "anyOf": [
        {
          "enum": [
            "layer1",
            "layer2"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Which layer caused a skip; null on buy",
      "title": "Decided By"
    },
    "failed_rule": {
      "anyOf": [
        {
          "enum": [
            "L1_PAYTO_MISMATCH",
            "L1_SELLER_UNTRUSTED",
            "L1_UNKNOWN_SELLER_CAP",
            "L1_AMOUNT_MISMATCH",
            "L1_OVER_MAX",
            "L1_OVER_BUDGET",
            "L1_NETWORK",
            "L1_ASSET",
            "L1_ITEM_MISMATCH",
            "L1_PRODUCT_MISMATCH",
            "L1_TIMEOUT"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failed Rule"
    },
    "risk_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk Score"
    },
    "threshold": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threshold"
    },
    "top_reasons": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Reason"
      },
      "maxItems": 3,
      "title": "Top Reasons",
      "type": "array"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "checks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Check"
      },
      "title": "Checks",
      "type": "array"
    }
  },
  "required": [
    "decision",
    "decided_by"
  ],
  "title": "GateDecision",
  "type": "object"
}
