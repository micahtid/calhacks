{
  "$defs": {
    "Checkout": {
      "additionalProperties": false,
      "description": "What the 402 actually demands. The Gate fetches it itself with a placeholder shipTo.",
      "properties": {
        "pay_to": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Pay To",
          "type": "string"
        },
        "amount": {
          "description": "USDC base units (6 decimals)",
          "pattern": "^[0-9]+$",
          "title": "Amount",
          "type": "string"
        },
        "network": {
          "title": "Network",
          "type": "string"
        },
        "asset": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Asset",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "max_timeout_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "maxTimeoutSeconds read straight from the 402, when known",
          "title": "Max Timeout Seconds"
        }
      },
      "required": [
        "pay_to",
        "amount",
        "network",
        "asset",
        "item_id"
      ],
      "title": "Checkout",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Store's product id; must match checkout.item_id",
          "title": "Id",
          "type": "string"
        },
        "product_key": {
          "description": "Our normalized product + variant; right product, which median",
          "title": "Product Key",
          "type": "string"
        },
        "condition": {
          "enum": [
            "new",
            "like_new",
            "used",
            "poor"
          ],
          "title": "Condition",
          "type": "string"
        },
        "price": {
          "description": "Total price in USD including shipping",
          "exclusiveMinimum": 0,
          "title": "Price",
          "type": "number"
        },
        "text": {
          "description": "Title + description + item specifics, exactly as served (raw)",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "product_key",
        "condition",
        "price",
        "text"
      ],
      "title": "Item",
      "type": "object"
    },
    "Seller": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Seller account; known-seller list lookup",
          "title": "Id",
          "type": "string"
        },
        "domain": {
          "description": "Site that runs the checkout; lookalike-domain check",
          "title": "Domain",
          "type": "string"
        },
        "pay_to": {
          "description": "Wallet in store.json; must match checkout.pay_to",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Pay To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "domain",
        "pay_to"
      ],
      "title": "Seller",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "listing_id": {
      "minLength": 1,
      "title": "Listing Id",
      "type": "string"
    },
    "seller": {
      "$ref": "#/$defs/Seller"
    },
    "item": {
      "$ref": "#/$defs/Item"
    },
    "reviews": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Reviews",
      "type": "array"
    },
    "checkout": {
      "$ref": "#/$defs/Checkout"
    }
  },
  "required": [
    "listing_id",
    "seller",
    "item",
    "checkout"
  ],
  "title": "Listing",
  "type": "object"
}
