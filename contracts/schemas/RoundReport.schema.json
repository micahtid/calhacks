{
  "$defs": {
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "usd": {
          "minimum": 0,
          "title": "Usd",
          "type": "number"
        },
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        }
      },
      "required": [
        "usd",
        "tokens"
      ],
      "title": "Cost",
      "type": "object"
    },
    "FailureCluster": {
      "additionalProperties": false,
      "properties": {
        "cause": {
          "title": "Cause",
          "type": "string"
        },
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "example_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Example Ids",
          "type": "array"
        }
      },
      "required": [
        "cause",
        "count"
      ],
      "title": "FailureCluster",
      "type": "object"
    },
    "FeatureChange": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "action": {
          "enum": [
            "add",
            "modify",
            "remove"
          ],
          "title": "Action",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "feature",
        "action",
        "rationale"
      ],
      "title": "FeatureChange",
      "type": "object"
    },
    "PromotionDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "promote",
            "revert"
          ],
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "PromotionDecision",
      "type": "object"
    },
    "Rate": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "lo": {
          "title": "Lo",
          "type": "number"
        },
        "hi": {
          "title": "Hi",
          "type": "number"
        },
        "k": {
          "title": "K",
          "type": "integer"
        },
        "n": {
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "lo",
        "hi",
        "k",
        "n"
      ],
      "title": "Rate",
      "type": "object"
    },
    "RoundMetrics": {
      "additionalProperties": false,
      "properties": {
        "layer1_catches": {
          "title": "Layer1 Catches",
          "type": "integer"
        },
        "layer2_recall": {
          "$ref": "#/$defs/Rate"
        },
        "fpr_real": {
          "$ref": "#/$defs/Rate",
          "description": "False blocks on real listings"
        },
        "per_family": {
          "additionalProperties": {
            "$ref": "#/$defs/Rate"
          },
          "title": "Per Family",
          "type": "object"
        },
        "adaptive_recall": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recall on white_box attacks"
        },
        "recall": {
          "$ref": "#/$defs/Rate",
          "description": "Full Gate recall on synthetic scams, excluding policy-bounded families"
        },
        "fpr": {
          "$ref": "#/$defs/Rate",
          "description": "Full Gate false-block rate on all legit listings"
        },
        "policy_bounded_recall": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Skip rate on policy-bounded scam families (families.json policy_bounded), reported apart from recall"
        },
        "layer2_fpr": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "False blocks among legit listings that pass Layer 1: the trained model's own mistakes. Layer 1 policy blocks (e.g. unknown wallets over the cap) are excluded"
        }
      },
      "required": [
        "layer1_catches",
        "layer2_recall",
        "fpr_real",
        "per_family",
        "recall",
        "fpr"
      ],
      "title": "RoundMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "round": {
      "title": "Round",
      "type": "integer"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Session Id"
    },
    "failures_by_cluster": {
      "items": {
        "$ref": "#/$defs/FailureCluster"
      },
      "title": "Failures By Cluster",
      "type": "array"
    },
    "feature_changes": {
      "items": {
        "$ref": "#/$defs/FeatureChange"
      },
      "title": "Feature Changes",
      "type": "array"
    },
    "train_params": {
      "additionalProperties": true,
      "title": "Train Params",
      "type": "object"
    },
    "metrics": {
      "$ref": "#/$defs/RoundMetrics"
    },
    "decision": {
      "$ref": "#/$defs/PromotionDecision"
    },
    "cost": {
      "$ref": "#/$defs/Cost"
    }
  },
  "required": [
    "round",
    "session_id",
    "failures_by_cluster",
    "feature_changes",
    "train_params",
    "metrics",
    "decision",
    "cost"
  ],
  "title": "RoundReport",
  "type": "object"
}
