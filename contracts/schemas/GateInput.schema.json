{
  "$defs": {
    "Checkout": {
      "additionalProperties": false,
      "description": "What the 402 actually demands. The Gate fetches it itself with a placeholder shipTo.",
      "properties": {
        "pay_to": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Pay To",
          "type": "string"
        },
        "amount": {
          "description": "USDC base units (6 decimals)",
          "pattern": "^[0-9]+$",
          "title": "Amount",
          "type": "string"
        },
        "network": {
          "title": "Network",
          "type": "string"
        },
        "asset": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Asset",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "max_timeout_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "maxTimeoutSeconds read straight from the 402, when known",
          "title": "Max Timeout Seconds"
        }
      },
      "required": [
        "pay_to",
        "amount",
        "network",
        "asset",
        "item_id"
      ],
      "title": "Checkout",
      "type": "object"
    },
    "CrsResult": {
      "additionalProperties": false,
      "properties": {
        "seller_id": {
          "title": "Seller Id",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        },
        "verified_at": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When verification was granted",
          "title": "Verified At"
        },
        "source": {
          "default": "crs",
          "description": "'crs' for the real API, 'stub' for the stand-in collection",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "seller_id",
        "verified"
      ],
      "title": "CrsResult",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Store's product id; must match checkout.item_id",
          "title": "Id",
          "type": "string"
        },
        "product_key": {
          "description": "Our normalized product + variant; right product, which median",
          "title": "Product Key",
          "type": "string"
        },
        "condition": {
          "enum": [
            "new",
            "like_new",
            "used",
            "poor"
          ],
          "title": "Condition",
          "type": "string"
        },
        "price": {
          "description": "Total price in USD including shipping",
          "exclusiveMinimum": 0,
          "title": "Price",
          "type": "number"
        },
        "text": {
          "description": "Title + description + item specifics, exactly as served (raw)",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "product_key",
        "condition",
        "price",
        "text"
      ],
      "title": "Item",
      "type": "object"
    },
    "KnownSeller": {
      "additionalProperties": false,
      "properties": {
        "seller_id": {
          "title": "Seller Id",
          "type": "string"
        },
        "pay_to": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Pay To",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        }
      },
      "required": [
        "seller_id",
        "pay_to",
        "domain"
      ],
      "title": "KnownSeller",
      "type": "object"
    },
    "Listing": {
      "additionalProperties": false,
      "properties": {
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "seller": {
          "$ref": "#/$defs/Seller"
        },
        "item": {
          "$ref": "#/$defs/Item"
        },
        "reviews": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Reviews",
          "type": "array"
        },
        "checkout": {
          "$ref": "#/$defs/Checkout"
        }
      },
      "required": [
        "listing_id",
        "seller",
        "item",
        "checkout"
      ],
      "title": "Listing",
      "type": "object"
    },
    "Mandate": {
      "additionalProperties": false,
      "description": "The user's rules, set once.",
      "properties": {
        "product_key": {
          "description": "What the user wants; stops injections that switch the product",
          "title": "Product Key",
          "type": "string"
        },
        "max_price": {
          "exclusiveMinimum": 0,
          "title": "Max Price",
          "type": "number"
        },
        "spend_remaining": {
          "minimum": 0,
          "title": "Spend Remaining",
          "type": "number"
        }
      },
      "required": [
        "product_key",
        "max_price",
        "spend_remaining"
      ],
      "title": "Mandate",
      "type": "object"
    },
    "References": {
      "additionalProperties": false,
      "description": "Looked up by the Gate. Never supplied by the store.",
      "properties": {
        "known_sellers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KnownSeller"
          },
          "title": "Known Sellers",
          "type": "array"
        },
        "crs_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrsResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "market_median": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Median"
        },
        "pay_to_first_seen": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pay To First Seen"
        }
      },
      "title": "References",
      "type": "object"
    },
    "Seller": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Seller account; known-seller list and CRS lookup",
          "title": "Id",
          "type": "string"
        },
        "domain": {
          "description": "Site that runs the checkout; lookalike-domain check",
          "title": "Domain",
          "type": "string"
        },
        "pay_to": {
          "description": "Wallet in store.json; must match checkout.pay_to",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Pay To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "domain",
        "pay_to"
      ],
      "title": "Seller",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A GateRequest after the Gate fetched the listing itself. This is what Layer 1 and Layer 2 evaluate.",
  "properties": {
    "mandate": {
      "$ref": "#/$defs/Mandate"
    },
    "listing": {
      "$ref": "#/$defs/Listing"
    },
    "references": {
      "$ref": "#/$defs/References"
    }
  },
  "required": [
    "mandate",
    "listing",
    "references"
  ],
  "title": "GateInput",
  "type": "object"
}
