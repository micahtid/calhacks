{
  "$defs": {
    "AnswerKey": {
      "additionalProperties": false,
      "properties": {
        "listing_id": {
          "title": "Listing Id",
          "type": "string"
        },
        "label": {
          "description": "Set by code, never by the LLM",
          "enum": [
            "scam",
            "legit"
          ],
          "title": "Label",
          "type": "string"
        },
        "family": {
          "description": "Scam type or legit subtype from families.json; 'real' for real listings",
          "title": "Family",
          "type": "string"
        },
        "base_listing_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The real listing it came from",
          "title": "Base Listing Id"
        },
        "attack_diff": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Exactly what changed, e.g. {\"checkout.pay_to\": \"0x45fE…c862 → 0x45fE…c8a2\"}",
          "title": "Attack Diff",
          "type": "object"
        },
        "attacker_knowledge": {
          "anyOf": [
            {
              "enum": [
                "blind",
                "white_box"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attacker Knowledge"
        }
      },
      "required": [
        "listing_id",
        "label",
        "family"
      ],
      "title": "AnswerKey",
      "type": "object"
    },
    "Checkout": {
      "additionalProperties": false,
      "description": "What the 402 actually demands. The Gate fetches it itself with a placeholder shipTo.",
      "properties": {
        "pay_to": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Pay To",
          "type": "string"
        },
        "amount": {
          "description": "USDC base units (6 decimals)",
          "pattern": "^[0-9]+$",
          "title": "Amount",
          "type": "string"
        },
        "network": {
          "title": "Network",
          "type": "string"
        },
        "asset": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Asset",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "max_timeout_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "maxTimeoutSeconds read straight from the 402, when known",
          "title": "Max Timeout Seconds"
        }
      },
      "required": [
        "pay_to",
        "amount",
        "network",
        "asset",
        "item_id"
      ],
      "title": "Checkout",
      "type": "object"
    },
    "GenInfo": {
      "additionalProperties": false,
      "properties": {
        "listing_id": {
          "title": "Listing Id",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bitdeer model, or null when only code changed the listing",
          "title": "Model"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "spec_id": {
          "title": "Spec Id",
          "type": "string"
        }
      },
      "required": [
        "listing_id",
        "model",
        "spec_id"
      ],
      "title": "GenInfo",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Store's product id; must match checkout.item_id",
          "title": "Id",
          "type": "string"
        },
        "product_key": {
          "description": "Our normalized product + variant; right product, which median",
          "title": "Product Key",
          "type": "string"
        },
        "condition": {
          "enum": [
            "new",
            "like_new",
            "used",
            "poor"
          ],
          "title": "Condition",
          "type": "string"
        },
        "price": {
          "description": "Total price in USD including shipping",
          "exclusiveMinimum": 0,
          "title": "Price",
          "type": "number"
        },
        "text": {
          "description": "Title + description + item specifics, exactly as served (raw)",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "product_key",
        "condition",
        "price",
        "text"
      ],
      "title": "Item",
      "type": "object"
    },
    "Listing": {
      "additionalProperties": false,
      "properties": {
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "seller": {
          "$ref": "#/$defs/Seller"
        },
        "item": {
          "$ref": "#/$defs/Item"
        },
        "reviews": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Reviews",
          "type": "array"
        },
        "checkout": {
          "$ref": "#/$defs/Checkout"
        }
      },
      "required": [
        "listing_id",
        "seller",
        "item",
        "checkout"
      ],
      "title": "Listing",
      "type": "object"
    },
    "Seller": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Seller account; known-seller list lookup",
          "title": "Id",
          "type": "string"
        },
        "domain": {
          "description": "Site that runs the checkout; lookalike-domain check",
          "title": "Domain",
          "type": "string"
        },
        "pay_to": {
          "description": "Wallet in store.json; must match checkout.pay_to",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Pay To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "domain",
        "pay_to"
      ],
      "title": "Seller",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "listing": {
      "$ref": "#/$defs/Listing"
    },
    "answer_key": {
      "$ref": "#/$defs/AnswerKey"
    },
    "gen": {
      "$ref": "#/$defs/GenInfo"
    }
  },
  "required": [
    "listing",
    "answer_key",
    "gen"
  ],
  "title": "SyntheticListing",
  "type": "object"
}
