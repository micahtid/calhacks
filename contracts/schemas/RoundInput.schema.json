{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "usd": {
          "minimum": 0,
          "title": "Usd",
          "type": "number"
        },
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "minutes": {
          "minimum": 0,
          "title": "Minutes",
          "type": "number"
        }
      },
      "required": [
        "usd",
        "tokens",
        "minutes"
      ],
      "title": "Budget",
      "type": "object"
    },
    "Checkout": {
      "additionalProperties": false,
      "description": "What the 402 actually demands. The Gate fetches it itself with a placeholder shipTo.",
      "properties": {
        "pay_to": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Pay To",
          "type": "string"
        },
        "amount": {
          "description": "USDC base units (6 decimals)",
          "pattern": "^[0-9]+$",
          "title": "Amount",
          "type": "string"
        },
        "network": {
          "title": "Network",
          "type": "string"
        },
        "asset": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Asset",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "max_timeout_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "maxTimeoutSeconds read straight from the 402, when known",
          "title": "Max Timeout Seconds"
        }
      },
      "required": [
        "pay_to",
        "amount",
        "network",
        "asset",
        "item_id"
      ],
      "title": "Checkout",
      "type": "object"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "usd": {
          "minimum": 0,
          "title": "Usd",
          "type": "number"
        },
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        }
      },
      "required": [
        "usd",
        "tokens"
      ],
      "title": "Cost",
      "type": "object"
    },
    "FailureCluster": {
      "additionalProperties": false,
      "properties": {
        "cause": {
          "title": "Cause",
          "type": "string"
        },
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "example_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Example Ids",
          "type": "array"
        }
      },
      "required": [
        "cause",
        "count"
      ],
      "title": "FailureCluster",
      "type": "object"
    },
    "FeatureChange": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "action": {
          "enum": [
            "add",
            "modify",
            "remove"
          ],
          "title": "Action",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "feature",
        "action",
        "rationale"
      ],
      "title": "FeatureChange",
      "type": "object"
    },
    "HoldoutTotals": {
      "additionalProperties": false,
      "description": "Totals only, never rows (C3).",
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "recall": {
          "$ref": "#/$defs/Rate"
        },
        "fpr": {
          "$ref": "#/$defs/Rate"
        }
      },
      "required": [
        "model_id",
        "recall",
        "fpr"
      ],
      "title": "HoldoutTotals",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Store's product id; must match checkout.item_id",
          "title": "Id",
          "type": "string"
        },
        "product_key": {
          "description": "Our normalized product + variant; right product, which median",
          "title": "Product Key",
          "type": "string"
        },
        "condition": {
          "enum": [
            "new",
            "like_new",
            "used",
            "poor"
          ],
          "title": "Condition",
          "type": "string"
        },
        "price": {
          "description": "Total price in USD including shipping",
          "exclusiveMinimum": 0,
          "title": "Price",
          "type": "number"
        },
        "text": {
          "description": "Title + description + item specifics, exactly as served (raw)",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "product_key",
        "condition",
        "price",
        "text"
      ],
      "title": "Item",
      "type": "object"
    },
    "Listing": {
      "additionalProperties": false,
      "properties": {
        "listing_id": {
          "minLength": 1,
          "title": "Listing Id",
          "type": "string"
        },
        "seller": {
          "$ref": "#/$defs/Seller"
        },
        "item": {
          "$ref": "#/$defs/Item"
        },
        "reviews": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Reviews",
          "type": "array"
        },
        "checkout": {
          "$ref": "#/$defs/Checkout"
        }
      },
      "required": [
        "listing_id",
        "seller",
        "item",
        "checkout"
      ],
      "title": "Listing",
      "type": "object"
    },
    "Miss": {
      "additionalProperties": false,
      "description": "A validation listing the Gate got wrong, with the Gate's reasons.",
      "properties": {
        "listing": {
          "$ref": "#/$defs/Listing"
        },
        "label": {
          "enum": [
            "scam",
            "legit"
          ],
          "title": "Label",
          "type": "string"
        },
        "family": {
          "title": "Family",
          "type": "string"
        },
        "decision": {
          "enum": [
            "buy",
            "skip"
          ],
          "title": "Decision",
          "type": "string"
        },
        "decided_by": {
          "anyOf": [
            {
              "enum": [
                "layer1",
                "layer2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decided By"
        },
        "top_reasons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Top Reasons",
          "type": "array"
        }
      },
      "required": [
        "listing",
        "label",
        "family",
        "decision",
        "decided_by"
      ],
      "title": "Miss",
      "type": "object"
    },
    "PromotionDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "promote",
            "revert"
          ],
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action",
        "reason"
      ],
      "title": "PromotionDecision",
      "type": "object"
    },
    "Rate": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "lo": {
          "title": "Lo",
          "type": "number"
        },
        "hi": {
          "title": "Hi",
          "type": "number"
        },
        "k": {
          "title": "K",
          "type": "integer"
        },
        "n": {
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "lo",
        "hi",
        "k",
        "n"
      ],
      "title": "Rate",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "contribution": {
          "title": "Contribution",
          "type": "number"
        }
      },
      "required": [
        "feature",
        "value",
        "contribution"
      ],
      "title": "Reason",
      "type": "object"
    },
    "RoundMetrics": {
      "additionalProperties": false,
      "properties": {
        "layer1_catches": {
          "title": "Layer1 Catches",
          "type": "integer"
        },
        "layer2_recall": {
          "$ref": "#/$defs/Rate"
        },
        "fpr_real": {
          "$ref": "#/$defs/Rate",
          "description": "False blocks on real listings"
        },
        "per_family": {
          "additionalProperties": {
            "$ref": "#/$defs/Rate"
          },
          "title": "Per Family",
          "type": "object"
        },
        "adaptive_recall": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recall on white_box attacks"
        },
        "recall": {
          "$ref": "#/$defs/Rate",
          "description": "Full Gate recall on synthetic scams"
        },
        "fpr": {
          "$ref": "#/$defs/Rate",
          "description": "Full Gate false-block rate on all legit listings"
        }
      },
      "required": [
        "layer1_catches",
        "layer2_recall",
        "fpr_real",
        "per_family",
        "recall",
        "fpr"
      ],
      "title": "RoundMetrics",
      "type": "object"
    },
    "RoundReport": {
      "additionalProperties": false,
      "properties": {
        "round": {
          "title": "Round",
          "type": "integer"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Session Id"
        },
        "failures_by_cluster": {
          "items": {
            "$ref": "#/$defs/FailureCluster"
          },
          "title": "Failures By Cluster",
          "type": "array"
        },
        "feature_changes": {
          "items": {
            "$ref": "#/$defs/FeatureChange"
          },
          "title": "Feature Changes",
          "type": "array"
        },
        "train_params": {
          "additionalProperties": true,
          "title": "Train Params",
          "type": "object"
        },
        "metrics": {
          "$ref": "#/$defs/RoundMetrics"
        },
        "decision": {
          "$ref": "#/$defs/PromotionDecision"
        },
        "cost": {
          "$ref": "#/$defs/Cost"
        }
      },
      "required": [
        "round",
        "session_id",
        "failures_by_cluster",
        "feature_changes",
        "train_params",
        "metrics",
        "decision",
        "cost"
      ],
      "title": "RoundReport",
      "type": "object"
    },
    "Seller": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Seller account; known-seller list and CRS lookup",
          "title": "Id",
          "type": "string"
        },
        "domain": {
          "description": "Site that runs the checkout; lookalike-domain check",
          "title": "Domain",
          "type": "string"
        },
        "pay_to": {
          "description": "Wallet in store.json; must match checkout.pay_to",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Pay To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "domain",
        "pay_to"
      ],
      "title": "Seller",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "round": {
      "minimum": 0,
      "title": "Round",
      "type": "integer"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "current_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Model Id"
    },
    "last_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoundReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "coverage": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Listing count per family so far",
      "title": "Coverage",
      "type": "object"
    },
    "misses": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Miss"
      },
      "title": "Misses",
      "type": "array"
    },
    "holdout_totals": {
      "anyOf": [
        {
          "$ref": "#/$defs/HoldoutTotals"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "feature_list": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Feature List",
      "type": "array"
    }
  },
  "required": [
    "round",
    "budget",
    "current_model_id"
  ],
  "title": "RoundInput",
  "type": "object"
}
