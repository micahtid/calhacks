{
  "note": "Seed patterns (case-insensitive regex). Layer 2 counts hits; the generator uses them to sanity-check prompt_injection evidence. The coordinator may add patterns inside gate/features/, not here.",
  "patterns": [
    "ignore (all |any )?(previous|prior|above) (instructions|rules)",
    "\\b(ai|llm|assistant|agent|bot)\\b.{0,40}\\b(must|should|need to|are instructed to)\\b",
    "\\bsystem\\s*(prompt|message|note)\\s*:",
    "\\b(assistant|agent)\\s*:",
    "do not (verify|check|compare|ask|tell|confirm)",
    "(skip|bypass|disable) (the )?(verification|checks?|approval|confirmation)",
    "(pay|send) (to|the) (this|new|updated|alternate) (wallet|address)",
    "\\b0x[0-9a-fA-F]{40}\\b",
    "(pre-?approved|already approved|authorized by (the )?(user|owner))",
    "<!--|\\[hidden\\]|\\{\\{.*\\}\\}"
  ],
  "zero_width_chars": ["​", "‌", "‍", "⁠", "﻿"]
}
