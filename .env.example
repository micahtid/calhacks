# Copy to .env (gitignored) and fill in. Read by the agent and all three stores.
# Atlas: Cluster -> Connect -> Drivers -> copy the mongodb+srv:// string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database names per app (optional; these are the defaults).
MONGODB_DB_AGENT=agent
MONGODB_DB_STORE_A=store-a
MONGODB_DB_STORE_B=store-b
MONGODB_DB_STORE_C=store-c
